# Telegram Bot Configuration
# Как получить:
# 1. Создайте бота через @BotFather в Telegram
# 2. Скопируйте токен бота
# 3. Получите chat_id через @userinfobot или отправив сообщение боту и проверив https://api.telegram.org/bot<TOKEN>/getUpdates

VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_chat_id_here

# В dev режиме (npm run dev) форма работает без настроек Telegram - сообщения выводятся в консоль
